{
  // ╔══════════════════════════════════════════════════════════════╗
  // ║  LINO LIVRE — Cloudflare Workers Configuration              ║
  // ║  Livros livres, para todos. 🇦🇴                             ║
  // ╚══════════════════════════════════════════════════════════════╝

  "name": "lino-livre",
  "account_id": "915a4372ce0d298d94b75276b8beda2f",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "workers/src/index.ts",

  // Workers Builds (CI integrado da Cloudflare via GitHub):
  // Sem passo de build separado — o wrangler compila e faz deploy direto.
  // Isto evita que o Workers Build tente executar "npm run build"
  // (que não existe) e falhe em ~1 min.
  "build": {
    "command": ""
  },

  // Static assets served by Cloudflare Pages-like functionality
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Cron diário: recalcula estatisticas/contadores às 00:10 UTC,
  // logo após o reset da cota diária de linhas lidas da D1.
  "triggers": {
    "crons": ["10 0 * * *"]
  },

  // Observability — structured logging and traces
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },

  // D1 Database — SQLite on the edge
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lino-livre-db",
      "database_id": "e63f1fb6-10b7-443e-b166-e355ec9e8f1c"
    }
  ],

  // R2 Object Storage — covers, PDFs, audio (10 GB free)
  // Enable R2 in dashboard first, then uncomment:
  // "r2_buckets": [
  //   {
  //     "binding": "ASSETS_BUCKET",
  //     "bucket_name": "lino-livre-assets"
  //   }
  // ],

  // KV Namespace — cache, rate limiting, counters
  // Create with: wrangler kv namespace create CACHE
  // Then add the id here
  // "kv_namespaces": [
  //   {
  //     "binding": "CACHE",
  //     "id": "<your-kv-namespace-id>"
  //   }
  // ],

  // Rate limiting distribuído (opcional). O código detecta o binding
  // RATE_LIMITER e, se existir, aplica o limite entre isolates/colos em vez do
  // contador em memória. Requer wrangler >= 4.35. Descomente para activar:
  // "ratelimits": [
  //   {
  //     "name": "RATE_LIMITER",
  //     "namespace_id": "1001",
  //     "simple": { "limit": 60, "period": 60 }
  //   }
  // ],

  // Non-secret environment variables
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_NAME": "Lino Livre",
    "SITE_SLOGAN": "Livros livres, para todos.",
    "DEFAULT_LOCALE": "pt",
    "ITEMS_PER_PAGE": "24",
    "MAX_ITEMS_PER_PAGE": "100",
    "WHATSAPP_COMMUNITY_URL": "https://chat.whatsapp.com/FobzGj8sibBI0EWfQrl2oU",
    "WHATSAPP_CHANNEL_URL": "https://whatsapp.com/channel/0029Vb8qMqDBlHpk2TQYwU0X",
    "SUPPORT_EMAIL": "bv6alblu6@mozmail.com",
    // 'd1' (padrão) ou 'supabase'. Para usar Supabase, definir também os
    // secrets SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY.
    "DB_BACKEND": "d1"
  }

  // Secrets (set via: wrangler secret put <NAME>):
  // - ADMIN_API_KEY                   (chave administrativa mestre para mutações POST/PUT/DELETE em produção)
  // - WHATSAPP_COMMUNITY_URL
  // - WHATSAPP_CHANNEL_URL
  // - GOOGLE_BOOKS_API_KEY (optional, for cover enrichment)
  // - SUPABASE_URL                    (ex.: https://xxxx.supabase.co)
  // - SUPABASE_SERVICE_ROLE_KEY       (servidor apenas — nunca no frontend)
}
