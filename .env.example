# ── Comunidade e Canal WhatsApp (Fase 8) ──────────────────────
# Com estas variáveis configuradas, o site exibe os botões e gera os QR codes SVG dinamicamente.
WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/SEU_CODIGO_DE_CONVITE
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/SEU_CODIGO_DE_CANAL

# ── Autenticação Administrativa ─────────────────────────────
# Chave secreta para rotas de mutação (POST/PUT/DELETE) e importadores assíncronos.
# Mínimo 16 caracteres. Sem esta variável, as mutações falham fechadas (503).
ADMIN_API_KEY=sua_chave_secreta_admin_aqui

# ── Proxy reverso / Rate limiting ───────────────────────────
# NUNCA defina isto sem ter realmente um proxy à frente. Com `1` (ou o IP/ CIDR
# do proxy), o servidor confia no primeiro salto de X-Forwarded-For.
# Sem proxy, deixe vazio: caso contrário qualquer cliente forja o IP e contorna
# o rate limiting (CWE-348). Exemplos: TRUST_PROXY=1 (nginx/Cloudflare Tunnel)
# ou TRUST_PROXY=loopback.
# TRUST_PROXY=1

# ── Anti-bot Turnstile (opcional, recomendado em produção) ──
# Só entra em acção quando AMBAS as chaves existem: o frontend só carrega o
# widget se /api/config anunciar TURNSTILE_SITE_KEY, e o servidor só exige o
# token se TURNSTILE_SECRET_KEY estiver definida (verificação falha-fechada).
# Sem chaves, a rota continua protegida por rate limiting + validação.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Rate limit distribuído no Worker: adicione ao wrangler.jsonc (opcional):
#   "ratelimits": [
#     { "name": "RATE_LIMITER", "namespace_id": "1001",
#       "simple": { "limit": 60, "period": 60 } }
#   ]
# Sem o binding, o Worker usa o contador em memória por isolate (degradação segura).

# ── Enriquecimento de Metadados (Opcional) ──────────────────
# GOOGLE_BOOKS_API_KEY=sua_chave_opcional_aqui

# ── Supabase (opcional) ─────────────────────────────────────
# Backend alternativo de metadados (Postgres). Ativação no Worker:
#   DB_BACKEND=supabase + os dois secrets abaixo.
# A chave de serviço NUNCA deve ir para o frontend.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Aliases aceites pelo script de migração (compatibilidade):
# DATA_API=https://SEU_PROJETO.supabase.co
# Secret_keys=sb_secret_...
