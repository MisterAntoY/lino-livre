{
  "name": "lino-livre",
  "version": "1.0.0",
  "description": "Lino Livre — Livros livres, para todos. Plataforma de livros digitais e cursos gratuitos.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "seed": "node src/database/seed.js",
    "test": "node --test --test-concurrency=1 test/**/*.test.js",
    "test:worker": "node --test test/worker.test.js",
    "livros": "node scripts/gerenciar_livros.js",
    "livros:csv": "node scripts/gerenciar_livros.js --exportar-csv",
    "cursos:sync": "node scripts/sincronizar_cursos.js",
    "cursos:sync:remote": "node scripts/sincronizar_cursos.js --remote",
    "sync:ocean": "node scripts/sync_ocean_brasil.js",
    "sync:mslearn": "node scripts/sync_ms_learn.js",
    "supabase:migrar": "node scripts/migrar_d1_para_supabase.js",
    "supabase:migrar:local": "node scripts/migrar_d1_para_supabase.js --local",
    "supabase:dry-run": "node scripts/migrar_d1_para_supabase.js --dry-run --tabela=fontes",
    "supabase:schema": "node scripts/aplicar_schema_supabase.js",
    "supabase:status": "node scripts/migrar_d1_para_supabase.js --status"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "hono": "^4.13.13",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "pg": "^8.23.1",
    "prisma": "^8.0.0-rc.23",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
